# Copy this file to .env for local development. Never commit real values.
NW_ENVIRONMENT=development
NW_DATABASE_URL=sqlite+aiosqlite:///./data/nightwatch.db
NW_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NW_WEBSOCKET_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NW_OPERATOR_TOKEN=replace-with-a-32-byte-operator-token
NW_FRONTEND_TOKEN=replace-with-a-32-byte-frontend-token
