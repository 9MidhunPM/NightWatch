# Copy this file to .env for local development. Never commit real values.
NW_ENVIRONMENT=development
NW_DATABASE_URL=sqlite+aiosqlite:///./data/nightwatch.db
NW_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NW_WEBSOCKET_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NW_OPERATOR_TOKEN=replace-with-a-32-byte-operator-token
NW_FRONTEND_TOKEN=replace-with-a-32-byte-frontend-token
NW_HEARTBEAT_INTERVAL_SECONDS=5
NW_MONITORING_ENABLED=true
NW_MONITOR_INTERVAL_SECONDS=10
NW_MONITOR_FAILURE_THRESHOLD=3
NW_MONITOR_TIMEOUT_SECONDS=3

# Optional read-only integrations; set only in deployment configuration.
NW_BESZEL_URL=
NW_BESZEL_SYSTEM_ID=
NW_BESZEL_EMAIL=
NW_BESZEL_PASSWORD=
NW_DOKPLOY_URL=
NW_DOKPLOY_API_KEY=
NW_DOKPLOY_GITHUB_ID=
NW_GITHUB_READ_TOKEN=
NW_DEPLOYMENT_SECRET_CATALOG=

# The Investigator calls only its typed, read-only tool broker.
NW_CODEX_API_KEY=
NW_CODEX_APP_SERVER_ENABLED=true
NW_CODEX_APP_SERVER_COMMAND=codex
NW_CODEX_APP_SERVER_TIMEOUT_SECONDS=25
NW_INVESTIGATOR_ENABLED=true
NW_INVESTIGATOR_MAX_TOOL_CALLS=12
NW_INVESTIGATOR_TIMEOUT_SECONDS=45

# Configure only a separately provisioned disposable target for repair evaluation.
NW_DEMO_URL=
NW_PUBLIC_DEMO_URL=
NW_DEMO_COMPOSE_FILE=
NW_DEMO_COMPOSE_PROJECT=
NW_DEMO_COMPOSE_SERVICE=
NW_DEMO_INTERNAL_HEALTH_URL=
NW_DEMO_EXPECTED_PORT=80
